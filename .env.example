# CLIMB v0.1 environment variables
# Copy to .env.local and fill in. NEVER commit .env / .env.local to git.

# Anthropic API key (required for AI diagnosis / AI chat)
ANTHROPIC_API_KEY=

# Claude model (optional - can also be changed in Settings screen)
# Default: claude-opus-5
CLIMB_CLAUDE_MODEL=

# Google Drive OAuth 2.0 (user's own Google account, not a service account).
# The redirect URI is derived automatically from the URL you access CLIMB at -
# just register that URI (e.g. https://<your-domain>/api/drive/oauth/callback)
# in the Google Cloud Console OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Data directory override (optional; default: ./data)
CLIMB_DATA_DIR=

# Password gate (REQUIRED when hosting CLIMB on the internet; optional on LAN).
# When set, every screen/API requires login with this password.
CLIMB_PASSWORD=
